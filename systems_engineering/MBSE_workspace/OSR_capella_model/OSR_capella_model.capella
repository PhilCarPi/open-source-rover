    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.oa:OperationalAnalysis"
        id="1ac666ab-1afe-4aaf-879f-7bc4af137a8f" name="Operational Analysis">
      <ownedFunctionPkg xsi:type="org.polarsys.capella.core.data.oa:OperationalActivityPkg"
          id="4388b005-675c-413e-8764-dbd7f043cb18" name="Operational Activities">
        <ownedOperationalActivities xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
            id="b09e9896-7edf-4ac0-aae8-00f368ecef94" name="Root Operational Activity"/>
      </ownedFunctionPkg>
      <ownedAbstractCapabilityPkg xsi:type="org.polarsys.capella.core.data.oa:OperationalCapabilityPkg"
          id="2c1cf999-c595-443b-8ea2-f1746440a579" name="Operational Capabilities">
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="57a240a1-185f-472f-b738-16f6d54f758f" name="Make Implementation Accessible to a Wide Range of Technical Expertise"
            description="&lt;h1>Capability Description&lt;/h1>&#xA;&#xA;&lt;p>Promote interested parties to engage in discussion with one onother so as to foment a sense of community around the project(s). This could take the form of online forums, in-person conferences, online chat rooms, etc.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="ed81a369-ca33-436b-b162-90a98d8297fb" name="Make Implementation Affordable"
            description="&lt;h1>Capability Description&lt;/h1>&#xA;&#xA;&lt;p>The total cost of implementing the &amp;quot;buil-to/code-to&amp;quot; specification should be such that it is comparable to similar&amp;nbsp;activities the BUILDER might engage with. For exmple if the project is a remote controlled vehicle, the budget should be similar to that needed to purchase an RC vehicle with comparable specifications. While finding comparables might not always be realistic, this capability should prompt the developer to perform a trade study to have a better idea of what the&amp;nbsp;BUILDER&amp;#39;s budget should be.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="96112bcc-42f3-444a-9a5c-596f530493fe" name="Promote Community Engagement"
            description="&lt;h1>Capability Description&lt;/h1>&#xA;&#xA;&lt;p>Promote interested parties to engage in discussion with one onother so as to foment a sense of community around the project(s). This could take the form of online forums, in-person conferences, online chat rooms, etc.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="cb359c1e-a50c-4950-a0e0-ed15a6f4c330" name="Develop and Maintain Mars Rover Technical Specification"
            description="&lt;h1>Capability Description&lt;/h1>&#xA;&#xA;&lt;p>Develop and maintain the &lt;u>technical specification&lt;/u> of an open-source Mars Rover project so as to make it accessible to anyone wishing to contribute to it or wishing to implement its specification.&lt;/p>&#xA;">
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="e66ed0c4-d121-4744-806e-39e69fc8443f" included="#57a240a1-185f-472f-b738-16f6d54f758f"/>
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="de932bf9-a7e9-4640-98b0-7b96a9f491ef" included="#ed81a369-ca33-436b-b162-90a98d8297fb"/>
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="0a242156-8d1e-451e-a745-c8f9858eb3ce" included="#96112bcc-42f3-444a-9a5c-596f530493fe"/>
        </ownedOperationalCapabilities>
      </ownedAbstractCapabilityPkg>
