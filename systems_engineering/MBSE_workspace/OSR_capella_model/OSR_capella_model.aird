      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_CdnA8OmCEe6FvuLSGur0Vw" documentation="&lt;h1>&lt;strong>Diagram Description&lt;/strong>&lt;/h1>&#xA;&#xA;&lt;p>This diagram shows all Operational Capabilities, without any other context (i.e., without Operational Entities or Actors), that are necessary and sufficient for the community to meet it&amp;#39;s operational objectives.&lt;/p>&#xA;&#xA;&lt;h1>&lt;strong>Diagram Purpose&lt;/strong>&lt;/h1>&#xA;&#xA;&lt;p>The purpose of this diagram is to validate and document the community&amp;#39;s Operational Capabilities. That is, to validate the community&amp;#39;s capabilities to provide a high-level service leading to the operational objectives being met.&lt;/p>&#xA;&#xA;&lt;h2>Operational Objectives&lt;/h2>&#xA;&#xA;&lt;ol>&#xA;&#x9;&lt;li>Offer a teaching and learning experience for those who want to get involved in mechanical engineering, software, electronics, and&amp;nbsp;robotics&lt;/li>&#xA;&#x9;&lt;li>Provide the blueprint for an open-source research platform for rugged terrain&lt;/li>&#xA;&lt;/ol>&#xA;" name="[OCB]_[operational_capabilities]" repPath="#_CdY-gOmCEe6FvuLSGur0Vw" changeId="1711732501040">
        <description xmi:type="description_1:DiagramDescription" href="platform:/plugin/org.polarsys.capella.core.sirius.analysis/description/oa.odesign#//@ownedViewpoints[name='Operational%20Analysis']/@ownedRepresentations[name='Operational%20Capabilities%20Blank']"/>
